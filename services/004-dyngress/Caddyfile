# diwansync ingress — reverse proxy with automatic HTTPS and Authelia forward-auth.
#
# Reads DOMAIN and CADDY_TLS from .env. CADDY_TLS=internal serves self-signed
# certs; set it to an email to get free Let's Encrypt certificates.

files.{$DOMAIN} {
	tls {$CADDY_TLS}

	# Public share links — no auth required.
	handle_path /public/share* {
		reverse_proxy 001-filebrowser:80
	}

	forward_auth 004-dyngress-authelia:9004 {
		uri /api/authz/forward-auth
	}
	reverse_proxy 001-filebrowser:80
}

immich.{$DOMAIN} {
	tls {$CADDY_TLS}

	# Web clients — Authelia handles authentication
	forward_auth 004-dyngress-authelia:9004 {
		uri /api/authz/forward-auth
	}
	reverse_proxy 002-immich-server:2283
}

app.immich.{$DOMAIN} {
	# Mobile app — strict mTLS, bypasses Authelia entirely
	tls {$CADDY_TLS} {
		client_auth {
			mode require
			trust_pool file /keys/002-immich-server.crt
		}
	}
	reverse_proxy 002-immich-server:2283
}

sync.{$DOMAIN} {
	tls {$CADDY_TLS}
	forward_auth 004-dyngress-authelia:9004 {
		uri /api/authz/forward-auth
	}
	reverse_proxy 003-syncthing:8384
}

ddns.{$DOMAIN} {
	tls {$CADDY_TLS}
	forward_auth 004-dyngress-authelia:9004 {
		uri /api/authz/forward-auth
	}
	reverse_proxy 004-dyngress-ddns-updater:8000
}

auth.{$DOMAIN} {
	tls {$CADDY_TLS}
	reverse_proxy 004-dyngress-authelia:9004
}
