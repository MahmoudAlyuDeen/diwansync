# 002-immich

# Database connection — required for Immich to start.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Auto-generated by init.sh if not set; uncomment to override.
# DB_PASSWORD=REPLACE_ME

# Remote access via SSO — only needed when reaching Immich from outside the local network.
# Uncomment and fill these in, then run services/002-immich/compile-remote-access.sh to build the config.
# CONFIG_OAUTH_CLIENT_ID=REPLACE_ME
# CONFIG_OAUTH_CLIENT_SECRET=REPLACE_ME
# CONFIG_OAUTH_ISSUER_URL=REPLACE_ME
# CONFIG_EXTERNAL_DOMAIN=REPLACE_ME