# 002-immich

# Remote access via OAuth SSO with a full identity provider; only needed when reaching Immich from outside the local network.
## get these from Authentik/Authelia/ Another OAuth2 or OpenID provider, or another IdP
# ENABLE_OAUTH=false: Ignored by default, change to true once configured.
ENABLE_OAUTH=false
# CONFIG_OAUTH_CLIENT_ID=REPLACE_ME
# CONFIG_OAUTH_CLIENT_SECRET=REPLACE_ME
# CONFIG_OAUTH_ISSUER_URL=REPLACE_ME

# External domain for share links — NOT applied from here without the compile step.
# Set it directly as `externalDomain` in services/002-immich/config.yml.
CONFIG_EXTERNAL_DOMAIN=http://example.com

ENABLE_SMTP=false
# Email notifications via SMTP.
## generate an app password for gmail under: https://myaccount.google.com/apppasswords, or another SMTP provider
# Uncomment and fill these, then run: scripts/compile-immich-config.sh
# SMTP_HOST=REPLACE_ME
# SMTP_PORT=587
# SMTP_USERNAME=REPLACE_ME
# SMTP_PASSWORD=REPLACE_ME
# SMTP_FROM=REPLACE_ME

# Database connection — required for Immich to start.
DB_DATABASE_NAME=002-immich
DB_USERNAME=002-immich

# Auto-generated by scripts/generate_secrets.sh if not set; uncomment to override.
# DB_PASSWORD=REPLACE_ME
