# 004-dyngress

VERSION_AUTHELIA=4.39.26
VERSION_CADDY=2.11.4-alpine
VERSION_DDNS_UPDATER=v2.10.0

# This domain is used by services to allow remote access:
# - Caddy templates it for service.${DOMAIN}
# - Authelia templates to define the auth cookie.
# - DDNS-updater uses it with the configured provider below to update the IP.
DOMAIN=example.com

# CADDY_TLS=internal: self-signed by caddy for local access.
# CADDY_TLS=email@provider.tld: free Let's Encrypt certs.
CADDY_TLS=internal

# Refresh interval.
# !Important: set to 10m after configuring a provider.
DDNS_PERIOD=168h
DDNS_PROVIDER=example
DDNS_GROUP=REPLACE_ME
DDNS_USERNAME=REPLACE_ME
DDNS_PASSWORD=REPLACE_ME

# Authelia uses Email to send codes to enable 2FA enrolment.
# Steps to configure Authelia:
# 1. Generate an app password for gmail under: https://myaccount.google.com/apppasswords, or another SMTP provider
# 2. Set AUTHELIA_SMTP_DISABLE_STARTUP_CHECK to 'false' only with valid params.
# 3. Set AUTHELIA_DEFAULT_POLICY to two_factor.
# 4. Optional: Enable passwordless login: AUTHELIA_WEBAUTHN_ENABLE_PASSKEY_LOGIN

SMTP_HOST=smtp.example.com
SMTP_PORT=1234
SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com

# 2.
AUTHELIA_SMTP_DISABLE_STARTUP_CHECK=true

# 3.
# options: bypass, one_factor, two_factor, deny
AUTHELIA_DEFAULT_POLICY=one_factor

# 4.
AUTHELIA_WEBAUTHN_ENABLE_PASSKEY_LOGIN=true

# Secrets genertated by scripts/generate_secrets.sh:
