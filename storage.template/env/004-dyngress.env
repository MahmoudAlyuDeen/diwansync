# 004-dyngress — Caddy (certs + proxy) and ddns-updater, sharing DOMAIN.

# The domain you own. Your services are reached at immich.<domain> and
# files.<domain>; ddns-updater keeps <domain> pointed at this machine's IP.
DOMAIN=example.com

# TLS: 'internal' = self-signed by caddy.
# !Important: Enter an email to get free Let's Encrypt certs.
CADDY_TLS=internal

# Refresh interval.
# !Important: lower to 10m once configured.
DDNS_PERIOD=168h

# ddns-updater provider credentials.
DDNS_PROVIDER=example
DDNS_GROUP=REPLACE_ME
DDNS_USERNAME=REPLACE_ME
DDNS_PASSWORD=REPLACE_ME

## generate an app password for gmail under: https://myaccount.google.com/apppasswords, or another SMTP provider
AUTHELIA_SMTP_SERVER=smtp.example.com
AUTHELIA_SMTP_PORT=587
AUTHELIA_SMTP_USERNAME=your-smtp-username@example.com
AUTHELIA_SMTP_PASSWORD=your-app-password
AUTHELIA_SMTP_EMAIL=noreply@example.com

# Authelia secrets — generate with scripts/generate_secrets.sh
# AUTHELIA_SESSION_SECRET=REPLACE_ME
# AUTHELIA_STORAGE_ENCRYPTION_KEY=REPLACE_ME
# AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=REPLACE_ME
