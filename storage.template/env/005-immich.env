# 005-immich
# Run init.sh to auto-generate secrets, or manually:
#   echo "DB_PASSWORD=$(openssl rand -base64 36)" >> storage.template/env/005-immich.env
#   echo "DB_USERNAME=postgres" >> storage.template/env/005-immich.env
#   echo "DB_DATABASE_NAME=immich" >> storage.template/env/005-immich.env

# Substituted into services/005-immich/config.yml by services/005-immich/compile.sh:
CONFIG_OAUTH_CLIENT_ID=REPLACE_ME
CONFIG_OAUTH_CLIENT_SECRET=REPLACE_ME
CONFIG_OAUTH_ISSUER_URL=REPLACE_ME
CONFIG_EXTERNAL_DOMAIN=REPLACE_ME
